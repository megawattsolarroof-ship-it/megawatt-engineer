{
  "rewrites": [
    {
      "source": "/scan.html",
      "destination": "https://megawatt-assets.vercel.app/scan.html"
    },
    {
      "source": "/scan",
      "destination": "https://megawatt-assets.vercel.app/scan.html"
    },
    {
      "source": "/register.html",
      "destination": "https://megawatt-assets2.vercel.app/register.html"
    },
    {
      "source": "/register",
      "destination": "https://megawatt-assets2.vercel.app/register.html"
    }
  ],
  "headers": [
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/face-api.min.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/evidence.js": {
      "maxDuration": 30
    }
  }
}